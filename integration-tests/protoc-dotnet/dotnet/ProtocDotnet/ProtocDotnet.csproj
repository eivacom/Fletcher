<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Eiva.Fletcher.ProtocDotnet</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>LatestMajor</RollForward>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Every analyser, as an error: the generated file must pass them in a consumer's
         build. It does so by opening with an <auto-generated> block, which Roslyn's
         analysers skip; this project is where that stays proven (BIND-6a). -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <!-- Rules aimed at library API design, which a test project's own code is not.
         CA2000 too: the tests view a RecordBatch's columns as a StructArray that shares
         the batch's own arrays, and disposing both would release them twice. -->
    <NoWarn>$(NoWarn);CA1515;CA1707;CA2007;CA1303;CA1305;CA1307;CA1310;CA1861;CA1859;CA2000</NoWarn>

    <!-- The plugin and protoc, as D-BIND-71's recipe takes them: a consumer gets
         $(FletcherProtocPlugin) from Eiva.Fletcher.Protoc (BIND-9); here CI and a
         developer set FLETCHER_PROTOC_PLUGIN, and PROTOC for protoc itself. -->
    <FletcherProtocPlugin Condition="'$(FletcherProtocPlugin)' == ''">$(FLETCHER_PROTOC_PLUGIN)</FletcherProtocPlugin>
    <FletcherProtoc Condition="'$(FletcherProtoc)' == ''">$(PROTOC)</FletcherProtoc>
    <FletcherProtoDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../proto'))</FletcherProtoDir>
    <FletcherGenDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)fletcher-gen</FletcherGenDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Apache.Arrow, the test framework, and Eiva.Fletcher.Model: the generated model
         must compile against Apache.Arrow alone (D-BIND-72), and the one Fletcher
         assembly it may add is Model, which holds the lossless Timestamp and Duration
         (D-BIND-74) and is itself Apache.Arrow only. A reference to Eiva.Fletcher here
         would hide exactly the failure this project exists to catch, and a test
         asserts the compiled assembly references no Fletcher assembly but Model.
         A ProjectReference because the package is not published until BIND-9; a
         consumer writes a PackageReference. -->
    <PackageReference Include="Apache.Arrow" Version="[23.0.0]" />
    <ProjectReference Include="../../../../dotnet/src/Fletcher.Model/Fletcher.Model.csproj" />
    <!-- BIND-6e: the classes of shared.proto and timestamp.proto, which model.proto's Route
         names, generated into another assembly, as a consumer's contracts project would
         hold them (D-BIND-80). -->
    <ProjectReference Include="../ProtocDotnetShared/ProtocDotnetShared.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.10.0]" />
    <PackageReference Include="xunit" Version="[2.9.3]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="[3.1.5]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the tests find the .ipc files the same protoc run wrote. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FletcherGenDir</_Parameter1>
      <_Parameter2>$(FletcherGenDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- D-BIND-71's consumer recipe, as a consumer would write it: protoc runs from an
       MSBuild Exec before compile, and the generated file joins @(Compile) inside the
       target, because it does not exist yet when the project is evaluated. `ipc` rides
       along so the tests can compare each generated Schema with the one C++ writes. -->
  <Target Name="FletcherGen" BeforeTargets="BeforeCompile;CoreCompile">
    <Error Condition="'$(FletcherProtocPlugin)' == '' Or !Exists('$(FletcherProtocPlugin)')"
           Text="FLETCHER_PROTOC_PLUGIN must name the built fletcher-protoc plugin (got '$(FletcherProtocPlugin)'). Build it with: conan create protoc" />
    <Error Condition="'$(FletcherProtoc)' == '' Or !Exists('$(FletcherProtoc)')"
           Text="PROTOC must name a protoc executable (got '$(FletcherProtoc)'). The Conan protobuf package ships one." />
    <PropertyGroup>
      <!-- protoc's well-known types ship beside it, in ../include. -->
      <_FletcherWkt>$([System.IO.Path]::GetFullPath('$([System.IO.Path]::GetDirectoryName($(FletcherProtoc)))/../include'))</_FletcherWkt>
    </PropertyGroup>
    <!-- csharp_model_only (D-BIND-76): this project is the Apache.Arrow-only consumer, so it
         opts out of the native pair, as a gateway or WASM project would. -->
    <RemoveDir Directories="$(FletcherGenDir)" />
    <MakeDir Directories="$(FletcherGenDir)" />
    <Exec Command="&quot;$(FletcherProtoc)&quot; --plugin=protoc-gen-fletcher=&quot;$(FletcherProtocPlugin)&quot; --fletcher_opt=csharp,csharp_model_only,ipc --fletcher_out=&quot;$(FletcherGenDir)&quot; -I &quot;$(FletcherProtoDir)&quot; -I &quot;$(_FletcherWkt)&quot; &quot;$(FletcherProtoDir)/model.proto&quot;" />
    <ItemGroup>
      <Compile Include="$(FletcherGenDir)/*.fletcher.cs" />
    </ItemGroup>
    <Error Condition="!Exists('$(FletcherGenDir)/model.fletcher.cs')"
           Text="protoc ran but wrote no model.fletcher.cs into $(FletcherGenDir)" />
  </Target>

</Project>
