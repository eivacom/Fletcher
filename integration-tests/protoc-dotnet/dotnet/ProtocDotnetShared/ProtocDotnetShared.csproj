<Project Sdk="Microsoft.NET.Sdk">

  <!-- BIND-6e: the generated model of proto/shared.proto, and of protoc's own
       google/protobuf/timestamp.proto, in an assembly of its own that ProtocDotnet
       references: the "contracts" project a consumer keeps shared messages in. model.proto
       imports shared.proto and declares `repeated google.protobuf.Timestamp`, so its
       generated classes name these ones in full and build their columns through their
       public ToArrow (D-BIND-80), never their internal ToArrowColumns. A consumer generates
       every file its imports reach; this project is where that is done, once. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TargetFramework>net10.0</TargetFramework>
    <AnalysisLevel>latest-all</AnalysisLevel>

    <FletcherProtocPlugin Condition="'$(FletcherProtocPlugin)' == ''">$(FLETCHER_PROTOC_PLUGIN)</FletcherProtocPlugin>
    <FletcherProtoc Condition="'$(FletcherProtoc)' == ''">$(PROTOC)</FletcherProtoc>
    <FletcherProtoDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../proto'))</FletcherProtoDir>
    <FletcherGenDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)fletcher-gen</FletcherGenDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Apache.Arrow, and since BIND-7 (D-BIND-105) Eiva.Fletcher.Model: both files are generated
         with csharp_accessor too, because model.proto's accessor reads Pos, Fix and Timestamp
         through theirs, and an accessor's windows live in Model (D-BIND-101). -->
    <PackageReference Include="Apache.Arrow" Version="[23.0.0]" />
    <ProjectReference Include="../../../../dotnet/src/Fletcher.Model/Fletcher.Model.csproj" />
  </ItemGroup>

  <!-- ProtocDotnet's FletcherGen recipe (D-BIND-71) over two files. timestamp.proto is named
       by its path under protoc's own include directory, so its output keeps that path:
       google/protobuf/timestamp.fletcher.cs. -->
  <Target Name="FletcherGen" BeforeTargets="BeforeCompile;CoreCompile">
    <Error Condition="'$(FletcherProtocPlugin)' == '' Or !Exists('$(FletcherProtocPlugin)')"
           Text="FLETCHER_PROTOC_PLUGIN must name the built fletcher-protoc plugin (got '$(FletcherProtocPlugin)'). Build it with: conan create protoc" />
    <Error Condition="'$(FletcherProtoc)' == '' Or !Exists('$(FletcherProtoc)')"
           Text="PROTOC must name a protoc executable (got '$(FletcherProtoc)'). The Conan protobuf package ships one." />
    <PropertyGroup>
      <_FletcherWkt>$([System.IO.Path]::GetFullPath('$([System.IO.Path]::GetDirectoryName($(FletcherProtoc)))/../include'))</_FletcherWkt>
    </PropertyGroup>
    <RemoveDir Directories="$(FletcherGenDir)" />
    <MakeDir Directories="$(FletcherGenDir)" />
    <Exec Command="&quot;$(FletcherProtoc)&quot; --plugin=protoc-gen-fletcher=&quot;$(FletcherProtocPlugin)&quot; --fletcher_opt=csharp,csharp_model_only,csharp_accessor --fletcher_out=&quot;$(FletcherGenDir)&quot; -I &quot;$(FletcherProtoDir)&quot; -I &quot;$(_FletcherWkt)&quot; &quot;$(FletcherProtoDir)/shared.proto&quot; google/protobuf/timestamp.proto" />
    <ItemGroup>
      <Compile Include="$(FletcherGenDir)/**/*.fletcher.cs;$(FletcherGenDir)/**/*.fletcher.accessor.cs;$(FletcherGenDir)/**/*.fletcher.arrow.cs" />
    </ItemGroup>
    <Error Condition="!Exists('$(FletcherGenDir)/shared.fletcher.cs') Or !Exists('$(FletcherGenDir)/google/protobuf/timestamp.fletcher.cs')"
           Text="protoc ran but did not write shared.fletcher.cs and google/protobuf/timestamp.fletcher.cs into $(FletcherGenDir)" />
  </Target>

</Project>
