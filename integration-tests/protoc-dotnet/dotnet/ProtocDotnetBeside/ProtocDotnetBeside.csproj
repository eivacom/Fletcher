<Project Sdk="Microsoft.NET.Sdk">

  <!-- BIND-6e: Fletcher's C# generated BESIDE protoc's own C# in one project, without CS0101.

       BIND-6's acceptance asks for "one whose type is generated beside protoc's C# output in one
       project without CS0101". A consumer that already uses protoc's C# messages adds Fletcher's
       for the same .proto files; this project is that consumer. One protoc call runs both
       generators over beside.proto and shared.proto into ONE directory, so the file names must not
       collide either (protoc writes Beside.cs, Fletcher beside.fletcher.cs; Windows compares names
       without case). Not model.proto: see beside.proto's header for why protoc 3.21.12's own C#
       cannot compile it. The two sets of types cannot collide because Fletcher owns its namespace,
       Fletcher.Gen.<Package>, and ignores csharp_namespace (D-BIND-69), while protoc uses
       csharp_namespace or the PascalCased package.

       timestamp.proto, which Route's `repeated google.protobuf.Timestamp` reaches, is generated by
       Fletcher only, in a second call: protoc's C# for the well-known types ships in the
       Google.Protobuf package, and generating it again would itself collide. ProtocDotnet stays
       the Apache.Arrow-only consumer; this project is the one that also references
       Google.Protobuf, at the version that matches protoc 3.21.12's output. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Eiva.Fletcher.ProtocDotnetBeside</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>LatestMajor</RollForward>
    <TargetFramework>net10.0</TargetFramework>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1515;CA1707;CA2007;CA1303;CA1305;CA1307;CA1310;CA1861;CA1859;CA2000</NoWarn>

    <FletcherProtocPlugin Condition="'$(FletcherProtocPlugin)' == ''">$(FLETCHER_PROTOC_PLUGIN)</FletcherProtocPlugin>
    <FletcherProtoc Condition="'$(FletcherProtoc)' == ''">$(PROTOC)</FletcherProtoc>
    <FletcherProtoDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../proto'))</FletcherProtoDir>
    <FletcherGenDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)fletcher-gen</FletcherGenDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="[23.0.0]" />
    <PackageReference Include="Google.Protobuf" Version="[3.21.12]" />
    <ProjectReference Include="../../../../dotnet/src/Fletcher.Model/Fletcher.Model.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.10.0]" />
    <PackageReference Include="xunit" Version="[2.9.3]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="[3.1.5]" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FletcherGenDir</_Parameter1>
      <_Parameter2>$(FletcherGenDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="FletcherGen" BeforeTargets="BeforeCompile;CoreCompile">
    <Error Condition="'$(FletcherProtocPlugin)' == '' Or !Exists('$(FletcherProtocPlugin)')"
           Text="FLETCHER_PROTOC_PLUGIN must name the built fletcher-protoc plugin (got '$(FletcherProtocPlugin)'). Build it with: conan create protoc" />
    <Error Condition="'$(FletcherProtoc)' == '' Or !Exists('$(FletcherProtoc)')"
           Text="PROTOC must name a protoc executable (got '$(FletcherProtoc)'). The Conan protobuf package ships one." />
    <PropertyGroup>
      <_FletcherWkt>$([System.IO.Path]::GetFullPath('$([System.IO.Path]::GetDirectoryName($(FletcherProtoc)))/../include'))</_FletcherWkt>
    </PropertyGroup>
    <RemoveDir Directories="$(FletcherGenDir)" />
    <MakeDir Directories="$(FletcherGenDir)" />
    <!-- Both generators, one call, one output directory. -->
    <Exec Command="&quot;$(FletcherProtoc)&quot; --plugin=protoc-gen-fletcher=&quot;$(FletcherProtocPlugin)&quot; --csharp_out=&quot;$(FletcherGenDir)&quot; --fletcher_opt=csharp,csharp_model_only --fletcher_out=&quot;$(FletcherGenDir)&quot; -I &quot;$(FletcherProtoDir)&quot; -I &quot;$(_FletcherWkt)&quot; &quot;$(FletcherProtoDir)/beside.proto&quot; &quot;$(FletcherProtoDir)/shared.proto&quot;" />
    <!-- The well-known type Route reaches, by Fletcher alone (see above). -->
    <Exec Command="&quot;$(FletcherProtoc)&quot; --plugin=protoc-gen-fletcher=&quot;$(FletcherProtocPlugin)&quot; --fletcher_opt=csharp,csharp_model_only --fletcher_out=&quot;$(FletcherGenDir)&quot; -I &quot;$(_FletcherWkt)&quot; google/protobuf/timestamp.proto" />
    <ItemGroup>
      <Compile Include="$(FletcherGenDir)/**/*.cs" />
    </ItemGroup>
    <Error Condition="!Exists('$(FletcherGenDir)/Beside.cs') Or !Exists('$(FletcherGenDir)/beside.fletcher.cs') Or !Exists('$(FletcherGenDir)/Shared.cs') Or !Exists('$(FletcherGenDir)/shared.fletcher.cs')"
           Text="protoc ran but did not write Beside.cs, beside.fletcher.cs, Shared.cs and shared.fletcher.cs into $(FletcherGenDir)" />
  </Target>

</Project>
