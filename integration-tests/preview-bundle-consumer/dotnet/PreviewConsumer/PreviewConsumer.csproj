<Project Sdk="Microsoft.NET.Sdk">

  <!-- BIND-9a-2: a consumer of the preview bundle and of nothing else from this repository.
       The Fletcher packages are PackageReferences at the bundle's version, restored from the
       bundle's nuget/ folder alone (run.sh writes the nuget.config); the C# for fix.proto is
       generated by the plugin Eiva.Fletcher.Protoc locates (BIND-9b-5, D-BIND-71), with protoc
       from Google.Protobuf.Tools as README-preview.md tells a tester to get it. Its version is
       the protoc component's, FletcherProtocVersion, which run.sh reads from the bundle (equal
       to FletcherVersion in a preview bundle). run.sh copies this project out of the
       checkout, so no Directory.Build.props of the repository applies.
       BIND-9a-4: the regions between snippet markers are shown, verbatim, in
       dotnet/README.package.md; scripts/check_readme_snippets.py keeps the two equal. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PreviewConsumer</RootNamespace>
  </PropertyGroup>

  <!-- <snippet name="csproj-references"> -->
  <ItemGroup>
    <PackageReference Include="Eiva.Fletcher" Version="[$(FletcherVersion)]" />
    <PackageReference Include="Eiva.Fletcher.GatewayClient" Version="[$(FletcherVersion)]" />
    <PackageReference Include="Eiva.Fletcher.Model" Version="[$(FletcherVersion)]" />
    <!-- The plugin, and protoc with the well-known .proto files, used at build time only. -->
    <PackageReference Include="Eiva.Fletcher.Protoc" Version="[$(FletcherProtocVersion)]" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf.Tools" Version="[3.36.1]" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>
  <!-- </snippet> -->

  <Target Name="FletcherCheckInputs" BeforeTargets="CollectPackageReferences;FletcherGenerate">
    <Error Condition="'$(FletcherVersion)' == ''" Text="Set FletcherVersion to the bundle's version (run.sh reads it from VERSION)." />
    <Error Condition="'$(FletcherProtocVersion)' == ''" Text="Set FletcherProtocVersion to the bundle's Eiva.Fletcher.Protoc version (run.sh reads it from nuget/)." />
  </Target>

  <!-- What the package must have set: the plugin, executable, and the options' folder. -->
  <Target Name="FletcherCheckPlugin" BeforeTargets="FletcherGenerate">
    <Error Condition="'$(FletcherProtocPlugin)' == '' Or !Exists('$(FletcherProtocPlugin)')"
           Text="Eiva.Fletcher.Protoc did not set FletcherProtocPlugin to a plugin (got '$(FletcherProtocPlugin)')." />
    <Error Condition="'$(FletcherProtoInclude)' == '' Or !Exists('$(FletcherProtoInclude)/fletcher/options.proto')"
           Text="Eiva.Fletcher.Protoc did not set FletcherProtoInclude to its options folder (got '$(FletcherProtoInclude)')." />
  </Target>

  <!-- <snippet name="csproj-generate"> -->
  <PropertyGroup>
    <Protoc Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(PkgGoogle_Protobuf_Tools)/tools/windows_x64/protoc.exe</Protoc>
    <Protoc Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(PkgGoogle_Protobuf_Tools)/tools/linux_x64/protoc</Protoc>
  </PropertyGroup>

  <Target Name="FletcherGenerate" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <FletcherOut>$(IntermediateOutputPath)fletcher</FletcherOut>
    </PropertyGroup>
    <!-- A NuGet package does not keep the executable bit (Eiva.Fletcher.Protoc sets its own). -->
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="chmod +x &quot;$(Protoc)&quot;" />
    <RemoveDir Directories="$(FletcherOut)" />
    <MakeDir Directories="$(FletcherOut)" />
    <Exec Command="&quot;$(Protoc)&quot; --plugin=protoc-gen-fletcher=&quot;$(FletcherProtocPlugin)&quot; --fletcher_out=&quot;$(FletcherOut)&quot; --fletcher_opt=csharp,csharp_gateway,csharp_accessor -I . -I &quot;$(FletcherProtoInclude)&quot; -I &quot;$(PkgGoogle_Protobuf_Tools)/tools&quot; fix.proto" />
    <ItemGroup>
      <Compile Include="$(FletcherOut)/*.cs" />
    </ItemGroup>
  </Target>
  <!-- </snippet> -->

  <Target Name="FletcherCheckGenerated" AfterTargets="FletcherGenerate">
    <Error Condition="!Exists('$(FletcherOut)/fix.fletcher.native.cs') Or !Exists('$(FletcherOut)/fix.fletcher.gateway.cs') Or !Exists('$(FletcherOut)/fix.fletcher.accessor.cs')"
           Text="protoc ran but did not write the native pair, the gateway pair and the accessor into $(FletcherOut)" />
  </Target>

</Project>
