<Project Sdk="Microsoft.NET.Sdk">

  <!-- BIND-9a-2: a consumer of the preview bundle and of nothing else from this repository.
       The Fletcher packages are PackageReferences at the bundle's version, restored from the
       bundle's nuget/ folder alone (run.sh writes the nuget.config); the C# for proto/fix.proto
       is generated by the bundle's plugin, with protoc from Google.Protobuf.Tools as
       README-preview.md tells a tester to get it. run.sh copies this project out of the
       checkout, so no Directory.Build.props of the repository applies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PreviewConsumer</RootNamespace>
    <FletcherProtoDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../proto'))</FletcherProtoDir>
    <FletcherGenDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)fletcher-gen/$(TargetFramework)</FletcherGenDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Eiva.Fletcher" Version="[$(FletcherPreviewVersion)]" />
    <PackageReference Include="Eiva.Fletcher.GatewayClient" Version="[$(FletcherPreviewVersion)]" />
    <PackageReference Include="Eiva.Fletcher.Model" Version="[$(FletcherPreviewVersion)]" />
    <!-- protoc and the well-known types, a build-time tool only. -->
    <PackageReference Include="Google.Protobuf.Tools" Version="[3.36.1]" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="FletcherCheckInputs" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(FletcherPreviewVersion)' == ''" Text="Set FletcherPreviewVersion to the bundle's version (run.sh reads it from VERSION)." />
  </Target>

  <!-- Generated before compile, as a consumer would: the model, the native pair and the
       gateway pair (csharp, csharp_gateway). -->
  <Target Name="FletcherGen" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <_FletcherProtocDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(PkgGoogle_Protobuf_Tools)/tools/windows_x64</_FletcherProtocDir>
      <_FletcherProtocDir Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(PkgGoogle_Protobuf_Tools)/tools/linux_x64</_FletcherProtocDir>
      <_FletcherProtoc Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(_FletcherProtocDir)/protoc.exe</_FletcherProtoc>
      <_FletcherProtoc Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(_FletcherProtocDir)/protoc</_FletcherProtoc>
    </PropertyGroup>
    <Error Condition="'$(FletcherPlugin)' == '' Or !Exists('$(FletcherPlugin)')"
           Text="FletcherPlugin must name the bundle's protoc-gen-fletcher (got '$(FletcherPlugin)')." />
    <Error Condition="'$(FletcherBundleProtoc)' == '' Or !Exists('$(FletcherBundleProtoc)/fletcher/options.proto')"
           Text="FletcherBundleProtoc must name the bundle's protoc/ folder (got '$(FletcherBundleProtoc)')." />
    <Error Condition="!Exists('$(_FletcherProtoc)')" Text="protoc not found in Google.Protobuf.Tools: $(_FletcherProtoc)" />
    <!-- A NuGet package does not keep the executable bit. -->
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="chmod +x &quot;$(_FletcherProtoc)&quot;" />
    <RemoveDir Directories="$(FletcherGenDir)" />
    <MakeDir Directories="$(FletcherGenDir)" />
    <Exec Command="&quot;$(_FletcherProtoc)&quot; --plugin=protoc-gen-fletcher=&quot;$(FletcherPlugin)&quot; --fletcher_opt=csharp,csharp_gateway --fletcher_out=&quot;$(FletcherGenDir)&quot; -I &quot;$(FletcherProtoDir)&quot; -I &quot;$(FletcherBundleProtoc)&quot; -I &quot;$(PkgGoogle_Protobuf_Tools)/tools&quot; &quot;$(FletcherProtoDir)/fix.proto&quot;" />
    <ItemGroup>
      <Compile Include="$(FletcherGenDir)/*.cs" />
    </ItemGroup>
    <Error Condition="!Exists('$(FletcherGenDir)/fix.fletcher.native.cs') Or !Exists('$(FletcherGenDir)/fix.fletcher.gateway.cs')"
           Text="protoc ran but did not write the native and gateway pairs into $(FletcherGenDir)" />
  </Target>

</Project>
