<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Eiva.Fletcher.Conformance</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>LatestMajor</RollForward>

    <!-- One TFM, unlike the unit tests. Those multi-target because the PACKAGE
         supports net8.0 and net10.0 and both must be exercised; this suite is
         about the wire bytes two Arrow implementations produce, which does not
         change with the runtime. Running it twice would double a CI lane's time
         to re-assert the same bytes. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced by PATH rather than by package: this suite runs against the
         working tree's binding, which is the thing under test. A PackageReference
         would test whatever was last published. -->
    <ProjectReference Include="../../../../dotnet/src/Fletcher/Fletcher.csproj" />
  </ItemGroup>

  <!-- The native shim, staged beside the test binary, exactly as the unit tests
       stage it: there is no NuGet layout in a source build, so the path is passed
       in. Absent, the rows FAIL rather than skip. -->
  <ItemGroup Condition="'$(FletcherNativeShim)' != '' And Exists('$(FletcherNativeShim)')">
    <None Include="$(FletcherNativeShim)"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.10.0]" />
    <PackageReference Include="xunit" Version="[2.9.3]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="[3.1.5]" />
  </ItemGroup>

</Project>
