<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# native peer of the cross-language lane (BIND-8d): the generated NATIVE pair over
       Eiva.Fletcher and its shim, a process of its own on the gateway's Fast DDS domain. The
       test project (CrossLang) starts it. Not in Fletcher.slnx, as no integration project is. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Eiva.Fletcher.CrossLang</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>LatestMajor</RollForward>
    <TargetFramework>net10.0</TargetFramework>

    <FletcherProtocPlugin Condition="'$(FletcherProtocPlugin)' == ''">$(FLETCHER_PROTOC_PLUGIN)</FletcherProtocPlugin>
    <FletcherProtoc Condition="'$(FletcherProtoc)' == ''">$(PROTOC)</FletcherProtoc>
    <FletcherProtoDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../proto'))</FletcherProtoDir>
    <FletcherCoverageProtoDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../protoc-coverage/proto'))</FletcherCoverageProtoDir>
    <FletcherOptionsDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../../protoc/include'))</FletcherOptionsDir>
    <FletcherGenDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)fletcher-gen</FletcherGenDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="[23.0.0]" />
    <ProjectReference Include="../../../../dotnet/src/Fletcher/Fletcher.csproj" />
    <ProjectReference Include="../../../../dotnet/src/Fletcher.Model/Fletcher.Model.csproj" />
    <!-- CoverageFixture.cs, shared with the unit tests, names xunit's TheoryData. -->
    <PackageReference Include="xunit.extensibility.core" Version="[2.9.3]" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../../dotnet/tests/Shared/CoverageFixture.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../Shared/RowCompare.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The native shim, staged beside the binary, as Fletcher.Tests does: a source build has no
       NuGet layout, so the path comes in as -p:FletcherNativeShim=<path>. -->
  <ItemGroup Condition="'$(FletcherNativeShim)' != '' And Exists('$(FletcherNativeShim)')">
    <None Include="$(FletcherNativeShim)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The model AND the native pair for crosslang.proto and the coverage.proto it imports. -->
  <Target Name="FletcherGen" BeforeTargets="BeforeCompile;CoreCompile">
    <Error Condition="'$(FletcherProtocPlugin)' == '' Or !Exists('$(FletcherProtocPlugin)')"
           Text="FLETCHER_PROTOC_PLUGIN must name the built fletcher-protoc plugin (got '$(FletcherProtocPlugin)'). Build it with: conan create protoc" />
    <Error Condition="'$(FletcherProtoc)' == '' Or !Exists('$(FletcherProtoc)')"
           Text="PROTOC must name a protoc executable (got '$(FletcherProtoc)'). The Conan protobuf package ships one." />
    <PropertyGroup>
      <_FletcherWkt>$([System.IO.Path]::GetFullPath('$([System.IO.Path]::GetDirectoryName($(FletcherProtoc)))/../include'))</_FletcherWkt>
    </PropertyGroup>
    <RemoveDir Directories="$(FletcherGenDir)" />
    <MakeDir Directories="$(FletcherGenDir)" />
    <Exec Command="&quot;$(FletcherProtoc)&quot; --plugin=protoc-gen-fletcher=&quot;$(FletcherProtocPlugin)&quot; --fletcher_opt=csharp --fletcher_out=&quot;$(FletcherGenDir)&quot; -I &quot;$(FletcherProtoDir)&quot; -I &quot;$(FletcherCoverageProtoDir)&quot; -I &quot;$(FletcherOptionsDir)&quot; -I &quot;$(_FletcherWkt)&quot; &quot;$(FletcherProtoDir)/crosslang.proto&quot; &quot;$(FletcherCoverageProtoDir)/coverage.proto&quot;" />
    <ItemGroup>
      <Compile Include="$(FletcherGenDir)/*.fletcher.cs;$(FletcherGenDir)/*.fletcher.native.cs" />
    </ItemGroup>
    <Error Condition="!Exists('$(FletcherGenDir)/crosslang.fletcher.native.cs')"
           Text="protoc ran but wrote no crosslang.fletcher.native.cs into $(FletcherGenDir)" />
  </Target>

</Project>
