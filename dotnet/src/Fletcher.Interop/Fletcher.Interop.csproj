<Project Sdk="Microsoft.NET.Sdk">

  <!-- The P/Invoke surface over the binding ABI, and the ONLY package in the
       round that carries native assets: one shim per RID under
       runtimes/<rid>/native/. Keeping them in one package is what isolates the
       RID matrix, the packed-size budget and the LGPL relinking question to a
       single artifact (D-BIND-13). -->
  <PropertyGroup>
    <PackageId>Eiva.Fletcher.Interop</PackageId>
    <RootNamespace>Eiva.Fletcher.Interop</RootNamespace>
    <Description>P/Invoke surface and native shim for Fletcher. Referenced by Eiva.Fletcher; not intended to be used directly.</Description>
    <PackageTags>fletcher;arrow;interop;native</PackageTags>
    <!-- D-BIND-81: safe for trimming and NativeAOT (see Eiva.Fletcher's project). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- BIND-3a: the declarations have arrived. BIND-9a-0 (D-BIND-134): the NATIVE
       ASSETS are packed when CI hands both shims in, one per RID, from the two legs
       of ci.dotnet's pack job:
         dotnet pack -p:FletcherShimLinuxX64=<libfletcher-c-abi.so>
                     -p:FletcherShimWinX64=<fletcher-c-abi.dll>
       A source build sets neither and produces an assembly that finds a shim
       staged beside it, as before. Both or neither: a package with one RID would
       install and then fail at the first P/Invoke on the other platform. -->
  <PropertyGroup>
    <!-- `LibraryImport`'s generated marshalling stubs are unsafe code by
         construction: they take addresses and pin. This is the only project in
         the round that needs it, which is the point of keeping the P/Invoke
         surface in a package of its own. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shim's surface is internal (it is not a supported API), and the tests
         drive it directly because BIND-3a's forcing property is about LOADING the
         shim rather than about anything the managed tier does with it. -->
    <!-- Eiva.Fletcher is the tier that gives these handles lifetimes and these
         status numbers exceptions; it is the intended and only consumer. -->
    <InternalsVisibleTo Include="Fletcher" />
    <InternalsVisibleTo Include="Fletcher.Tests" />
    <!-- BIND-5b's copy oracle reaches the provider's native handle and the ABI's
         own types, to hand the probe shim's `fl_test_*` entry points what they
         score (D-BIND-61). A test assembly, never shipped. -->
    <InternalsVisibleTo Include="Fletcher.CopyOracle.Tests" />
  </ItemGroup>

  <!-- The shim's file names are what .NET probes for LibraryName "fletcher-c-abi"
       under runtimes/<rid>/native/; only the shipped shim, never the test-only probe. -->
  <ItemGroup Condition="'$(FletcherShimLinuxX64)' != '' And '$(FletcherShimWinX64)' != ''">
    <None Include="$(FletcherShimLinuxX64)" Pack="true" PackagePath="runtimes/linux-x64/native/libfletcher-c-abi.so" Visible="false" />
    <None Include="$(FletcherShimWinX64)" Pack="true" PackagePath="runtimes/win-x64/native/fletcher-c-abi.dll" Visible="false" />
  </ItemGroup>

  <Target Name="FletcherCheckShims" BeforeTargets="GenerateNuspec"
          Condition="'$(FletcherShimLinuxX64)' != '' Or '$(FletcherShimWinX64)' != ''">
    <Error Condition="'$(FletcherShimLinuxX64)' == '' Or '$(FletcherShimWinX64)' == ''"
           Text="Eiva.Fletcher.Interop packs both shims or none: set FletcherShimLinuxX64 and FletcherShimWinX64 together." />
    <Error Condition="!Exists('$(FletcherShimLinuxX64)')" Text="FletcherShimLinuxX64 does not exist: $(FletcherShimLinuxX64)" />
    <Error Condition="!Exists('$(FletcherShimWinX64)')" Text="FletcherShimWinX64 does not exist: $(FletcherShimWinX64)" />
  </Target>

</Project>
