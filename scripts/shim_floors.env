#
# BIND-9a (D-BIND-141, D-BIND-149): the linux-x64 shim's platform floors, in one place.
# scripts/check_shim_dependencies.sh requires the shim's highest GLIBC_ and GLIBCXX_
# symbol versions to EQUAL these, and scripts/check_dotnet_packages.sh requires the
# package README to state them; so a build-image change that moves a floor fails both
# until this file and dotnet/README.package.md are changed with it.
GLIBC_FLOOR=2.38
GLIBCXX_FLOOR=3.4.32
